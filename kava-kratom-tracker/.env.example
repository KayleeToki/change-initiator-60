# LegiScan API
VITE_LEGISCAN_API_KEY=your_legiscan_key_here

# Set to true to keep the LegiScan key server-side via the Supabase edge function.
# When true, VITE_LEGISCAN_API_KEY can be left empty here and set in Supabase secrets.
VITE_USE_EDGE_PROXY=false

# Supabase (only needed for the moderated discussion feature)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Footer backlink
VITE_ROOKREADER_URL=https://rookreader.com
